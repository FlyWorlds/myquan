ng","boundingRect":[-10010,-10010,20,20],"pos":[10,36],"link":null,"hide":true,"fieldName":"code"},{"locked":false,"name":"上传文件","type":"array","widget":null,"boundingRect":[237.87802124023438,744.2257080078125,20,20],"link":null,"hide":false,"fieldName":"uploaded_files"}],"outputs":[{"locked":false,"name":"策略代码","type":"string","boundingRect":[428.8780212402344,744.2257080078125,20,20],"links":[12],"hide":false,"fieldName":"code"}],"title":"Python代码输入","properties":{"策略代码":"class CombinedFactor(Factor):\n    def calculate(self, factors):\n        volume = factors['volume']\n        large_order_volume = TS_MAX(volume,20)\n        large_order_ratio = large_order_volume / volume\n        buy_signal = (large_order_ratio > 0.01).astype(int)\n        sell_signal = (large_order_ratio < 0).astype(int) * -1\n\n        close = factors['close']\n        obv = (volume * ((close - close.shift(1)) / close.shift(1))).cumsum()\n        obv_90_high = obv.rolling(window=90).max()\n        obv_30_ma = obv.rolling(window=30).mean()\n        obv_signal = ((obv == obv_90_high) & (obv > obv_30_ma)).astype(int)\n\n        return buy_signal + sell_signal + obv_signal","title":"Python代码输入"},"color":"#232","bgcolor":"#353","_fullTitle":"Python代码输入"},{"id":18,"type":"FactorAnalysisChartControl","pos":[2025.861328125,414.3033752441406],"size":[210,75],"flags":{"uuid":"90e2f3a6-306f-4328-a539-b911adf74fd5","plugin_source":"official","type":""},"order":11,"mode":0,"inputs":[{"locked":false,"name":"分析结果","type":"string","widget":null,"boundingRect":[2025.861328125,418.3033752441406,20,20],"link":22,"hide":false,"fieldName":"task_id"}],"outputs":[{"locked":false,"name":"图表绘制","type":"string","boundingRect":[2216.861328125,418.3033752441406,20,20],"links":null,"hide":false,"fieldName":"task_id"},{"locked":false,"name":"结果JSON","type":"string","boundingRect":[2216.861328125,438.3033752441406,20,20],"links":null,"hide":false,"fieldName":"result_json"}],"title":"因子分析结果","properties":{"分析结果":"error","t